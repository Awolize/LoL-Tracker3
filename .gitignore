# Environment files
.env
.env.local
.env.*.local

# Docker data directories
db/data/
db/share/
# Ignore contents, not the directories themselves, so the .gitkeep markers
# keep ./rustfs/data and ./rustfs/logs owned by the deploy user on a fresh clone
# (Docker would otherwise create them as root and RustFS could not write to them).
rustfs/data/*
rustfs/logs/*
!rustfs/data/.gitkeep
!rustfs/logs/.gitkeep

# Database backups
backup_*.sql

# Docker volumes
docker-compose.override.yml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.cache/

# Build outputs (if built at root)
dist/
build/
.output/