{
	"name": "app",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --import ./instrument.server.mjs ./node_modules/vite/bin/vite.js dev --port 3001",
		"start": "node --import ./instrument.server.mjs .output/server/index.mjs",
		"build": "vite build",
		"serve": "vite preview",
		"test": "vitest run",
		"format": "oxfmt --write .",
		"lint": "oxlint .",
		"check": "oxlint . && oxfmt --check .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:prod": "tsx src/db/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"db:backfill-participants": "tsx scripts/backfill-match-participants.ts",
		"queue:verify-stable-ids": "tsx scripts/verify-stable-queue-job-ids.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1146.0",
		"@headlessui/react": "^2.2.10",
		"@nivo/core": "^0.99.0",
		"@nivo/line": "^0.99.0",
		"@radix-ui/react-dropdown-menu": "^2.1.25",
		"@radix-ui/react-label": "^2.1.16",
		"@radix-ui/react-slider": "^1.5.0",
		"@radix-ui/react-slot": "^1.4.0",
		"@radix-ui/react-switch": "^1.3.8",
		"@sentry/tanstackstart-react": "^11.4.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/router-plugin": "^1.168.42",
		"bullmq": "^6.3.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"ioredis": "^6.0.0",
		"lucide-react": "^1.52.0",
		"motion": "^14.0.0",
		"nitro": "3.0.260903-beta",
		"pg": "^8.23.1",
		"radix-ui": "^1.7.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sharp": "^0.35.5",
		"superjson": "^2.2.6",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"twisted": "^1.83.0",
		"zod": "4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "latest",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
