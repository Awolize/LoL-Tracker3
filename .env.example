# Riot API Key (get from https://developer.riotgames.com/)
RIOT_API_KEY=RGAPI-your-api-key-here

# Database
DATABASE_URL=postgresql://postgres:password@db:5432/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Object storage (S3-compatible; served by RustFS in docker-compose.yml).
# MINIO_* names are kept because the app reads them — "rustfs" is the compose service name.
MINIO_ENDPOINT=rustfs
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional: Sentry (error tracking)
# VITE_SENTRY_ORG=
# VITE_SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
